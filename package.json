{
  "name": "frontend-workspace",
  "private": true,
  "workspaces": [
    "musiclib",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build -ws",
    "build:lib": "npm run build --workspace musiclib",
    "build:frontend": "npm run build --workspace frontend",
    "deploy": "npm run build:lib && npm run build:frontend && npm run deploy:pages --workspace frontend"
  }
}
